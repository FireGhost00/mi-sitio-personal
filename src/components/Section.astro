---
interface Props {
  title: string;
  id?: string;
}

const { title, id } = Astro.props;
---

<section class="section" id={id}>
  <div class="container">
    <h2>{title}</h2>
    <slot />
  </div>
</section>

<style>
  .section {
    padding: 4rem 2rem;
  }
  
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }
  
  h2 {
    margin-bottom: 2rem;
    text-align: center;
  }
  
  @media (max-width: 768px) {
    .section {
      padding: 3rem 1.5rem;
    }
  }
</style>
